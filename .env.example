# Runtime: development locally; use production when deployed.
APP_ENV=development

# MySQL connection. Prefer DATABASE_URL on managed providers.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=ofertas
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database
# Providers may instead supply MYSQL_URL or MYSQLHOST/MYSQLPORT/MYSQLUSER/
# MYSQLPASSWORD/MYSQLDATABASE; the backend accepts those names too.

# Comma-separated frontend origins. Keep the local origin during development.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Required in production. Use a unique random value of at least 32 characters.
ADMIN_USERNAME=your_admin_user
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_SECRET_KEY=replace_with_at_least_32_random_characters

# Mercado Livre API. Keep this token private and never commit it.
MELI_ACCESS_TOKEN=
